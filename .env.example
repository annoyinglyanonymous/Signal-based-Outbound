# Copy to .env (local) or /etc/truckshield.env (server). Never commit values.
# Dev and prod use separate tokens and Supabase projects.

# --- Required -------------------------------------------------------------
# data.transportation.gov app token
SOCRATA_TOKEN=
# Supabase: use the SESSION POOLER string (Connect > Session pooler); it works over IPv4
SUPABASE_DB_URL=

# --- Cloudflare R2 (leave empty to skip uploads, e.g. locally) -------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=truckshield-fmcsa

# --- Alerts -------------------------------------------------------------
# Slack or Discord incoming webhook, posted to when a run fails
ALERT_WEBHOOK_URL=
# Dead man's switch ping URLs (e.g. healthchecks.io): one check per job.
# Suggested schedules: daily = every day 06:00 Asia/Kathmandu, grace 3h;
#                      weekly = Sundays 00:30 Asia/Kathmandu, grace 8h
HEALTHCHECK_URL_DAILY=
HEALTHCHECK_URL_WEEKLY=

# --- Outreach -----------------------------------------------------------
# true = shadow mode: queue and review, but nothing is released for sending
OUTREACH_SHADOW=true
QUEUE_SIZE=300
QUEUE_MIX=cancellation:50,renewal:20,new_entrant:15,fleet_growth:10,specialty:5
OUTREACH_COOLDOWN_DAYS=30

# --- Contacts -----------------------------------------------------------
# mx (free domain check) or zerobounce (paid mailbox check)
VERIFY_PROVIDER=mx
ZEROBOUNCE_API_KEY=
VERIFY_MONTHLY_CAP=1000
ENRICH_MONTHLY_CAP=500

# --- Signal rules (defaults shown) ----------------------------------------
# CANCEL_DAYS=30
# RENEWAL_DAYS=60
# ENTRANT_DAYS=60
# COOLDOWN_DAYS=90
# SPECIALTY_PER_WEEK=200
# FLEET_COMPARE_DAYS=28
# FLEET_MIN_ADD=2
# FLEET_MIN_PCT=20
# SPECIALTY_CARGO=chem,liqgas,oilfield,livestock,coldfood,meat,intermodal,passengers,mobilehome,drivetow,motoveh,logpole,machlrg,garbage

# --- Machine limits (defaults shown) --------------------------------------
# DUCKDB_MEMORY_LIMIT=1GB
# DUCKDB_THREADS=2
