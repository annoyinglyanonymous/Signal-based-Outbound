# Copy to .env (local) or set as environment variables (Droplet). Never commit values.
# Dev and prod use separate tokens and Supabase keys.
SOCRATA_TOKEN=
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres

# Optional overrides
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2
RAW_DIR=data/raw
PARQUET_DIR=data/parquet
WORK_DIR=data/work
